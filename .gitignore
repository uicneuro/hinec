### macOS ###
# General
.DS_Store
.AppleDouble
.LSOverride

# Icon must end with two \r
Icon


# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

### macOS Patch ###
# iCloud generated files
*.icloud

### MATLAB ###
# Windows default autosave extension
*.asv
*.mat

# OSX / *nix default autosave extension
*.m~

# Compiled MEX binaries (all platforms)
*.mex*

# Packaged app and toolbox files
*.mlappinstall
*.mltbx

# Generated helpsearch folders
helpsearch*/

# Simulink code generation folders
slprj/
sccprj/

# Matlab code generation folders
codegen/

# Simulink autosave extension
*.autosave

# Simulink cache files
*.slxc

# Octave session info
octave-workspace

# End of https://www.toptal.com/developers/gitignore/api/macos,matlab

sample.mat

# SPM12 (large external dependency)
spm12/
lib/spm12/

ISMRM/*

*_figures*/*

# agent related
.claude/*
AGENTS.md
CLAUDE.md

*.log

*_data*

validation_results*

# HINEC run directories (organized output)
hinec_runs/

# MkDocs build output
site/

# Experiment results (old runs, figures, challenge data)
experiments/
# Large experiment artifacts (ISMRM validation) — not for upstream
mrtrix_runs/
lib/spm12.zip
data/ismrm2015/*
!data/ismrm2015/README.md

# ===== MMF / tractography work additions =====

# Python bytecode caches
__pycache__/
*.pyc
*.pyo

# NIfTI volumes and tractography exports are data / large binaries — never commit
*.nii
*.nii.gz
*.trk
*.tck

# LaTeX report — a deliverable, not part of the code repo
report_mmf/

# One-time DSE / exploration figures + data blobs. docs/ is the user-facing
# mkdocs source; these scratch figures are not part of the generated site.
docs/figs/

# Internal research notes not in the mkdocs nav (not user-facing docs)
docs/INTERP_GAIN_AT_OPTIMUM.md

# Personal discussion / reference notes — not part of the code repo
DiscussionWithPeng_Winter2026.pdf
